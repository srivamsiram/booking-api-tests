<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- All tests except known bugs. Test classes run in parallel (4 threads). Run: mvn test -Pregression -->
<suite name="Regression Suite" verbose="1" parallel="classes" thread-count="4">
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
                <exclude name="known-bug"/>
            </run>
        </groups>
        <packages>
            <package name="com.booking.tests"/>
        </packages>
    </test>
</suite>
