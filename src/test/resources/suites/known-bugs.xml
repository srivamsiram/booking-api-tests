<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Tests that prove API defects. EXPECTED TO FAIL until the API is fixed. Run: mvn test -Pknown-bugs -->
<suite name="Known Bugs Suite" verbose="1">
    <test name="Known Bug Tests">
        <groups>
            <run>
                <include name="known-bug"/>
            </run>
        </groups>
        <packages>
            <package name="com.booking.tests"/>
        </packages>
    </test>
</suite>
